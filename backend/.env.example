# ---- Supermat backend ----
PORT=5001
# Rahasia JWT sesi login (wajib diganti)
JWT_SECRET=ganti-dengan-string-acak-panjang
# Supabase. Pakai service_role key (Project Settings → API Keys). Kosongkan untuk mode dev dengan database.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Schema tabel Markimate (default public). Di project bersama pakai: markimate
SUPABASE_SCHEMA=markimate
# n8n 3Our
N8N_BASE_URL=https://n8n.3ourasia.id
# Key 3Our untuk memanggil webhook n8n (harus sama dengan MARKIMATE_API_KEYS / SUPERMAT_API_KEYS di node "Auth & Normalize")
MARKIMATE_API_KEY=   # isi di Vercel (Secret); SUPERMAT_API_KEY masih didukung sementara sebagai fallback
# Override URL webhook n8n (opsional; fallback ke SUPERMAT_N8N_* bila tidak diisi)
# MARKIMATE_N8N_RUN_URL=
# MARKIMATE_N8N_PUBLISH_URL=
# MARKIMATE_N8N_TOPICS_URL=
# Rahasia untuk Vercel Cron (/api/cron/run-scheduled)
CRON_SECRET=ganti-dengan-string-acak
# Origin frontend yang diizinkan (pisah koma). Kosong = izinkan localhost & *.vercel.app
FRONTEND_ORIGIN=https://markimate.vercel.app,https://supermat-three.vercel.app
# Kuota artikel/bulan paket Free
FREE_MONTHLY_LIMIT=3
# Kunci enkripsi kredensial CMS (32 byte base64). Contoh generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
CMS_CRED_KEY=
# Path endpoint n8n untuk topik otomatis
N8N_URL_TOPICS=/webhook/supermat-topics

# ---- Sistem Credit & Free Trial 7 Hari ----
CREDITS_ENABLED=true
TRIAL_CREDITS=300
TRIAL_DAYS=7
# Kunci admin (header X-Admin-Key) untuk monitoring margin & update harga
ADMIN_KEY=ganti-dengan-rahasia-admin
ADMIN_ALERT_EMAIL=
ADMIN_TELEGRAM_CHAT_ID=
COST_DAILY_ALERT_IDR=500000

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Billing Checkout Dummy (default false; hanya diset true untuk testing dev lokal)
BILLING_DUMMY=false

# ---- Auth, Sesi, Email & Workspace (F1 & F2) ----
APP_URL=https://app.markimate.com
RESEND_API_KEY=
MAIL_FROM=Markimate <noreply@mail.markimate.com>
EMAIL_FROM=
MAIL_DEV_LOG=false
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
LEGACY_JWT_ACCEPT_UNTIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_MOCK=
META_APP_SECRET=
