# ---- Supermat backend ----
PORT=5001
# Rahasia JWT sesi login (wajib diganti)
JWT_SECRET=ganti-dengan-string-acak-panjang
# Supabase. Pakai service_role key (Project Settings → API Keys). Kosongkan untuk mode dev dengan database.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Schema tabel Supermat (default public). Di project bersama pakai: supermat
SUPABASE_SCHEMA=supermat
# n8n 3Our
N8N_BASE_URL=https://n8n.3ourasia.id
# Key 3Our untuk memanggil webhook n8n (harus sama dengan SUPERMAT_API_KEYS / default di node "Auth & Normalize")
SUPERMAT_API_KEY=   # isi di Vercel (Secret), sama dengan key di node n8n "Auth & Normalize"
# Rahasia untuk Vercel Cron (/api/cron/run-scheduled)
CRON_SECRET=ganti-dengan-string-acak
# Origin frontend yang diizinkan (pisah koma). Kosong = izinkan localhost & *.vercel.app
FRONTEND_ORIGIN=https://markimate.vercel.app,https://supermat-three.vercel.app
# Kuota artikel/bulan paket Free
FREE_MONTHLY_LIMIT=3
